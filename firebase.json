{
    "firestore":  {
                      "database":  "(default)",
                      "location":  "nam5",
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "hosting":  {
                    "public":  "dist/salon/browser",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                },
    "emulators":  {
                      "auth":  {
                                   "port":  9099
                               },
                      "firestore":  {
                                        "port":  8080
                                    },
                      "hosting":  {
                                      "port":  5000
                                  },
                      "ui":  {
                                 "enabled":  true,
                                 "port":  4000
                             },
                      "singleProjectMode":  true,
                      "functions":  {
                                        "port":  5001
                                    }
                  },
    "auth":  {
                 "providers":  {
                                   "emailPassword":  true,
                                   "googleSignIn":  {
                                                        "oAuthBrandDisplayName":  "Chairly",
                                                        "supportEmail":  "h9785095253@gmail.com"
                                                    }
                               }
             },
    "functions":  [
                      {
                          "ignore":  [
                                         "node_modules",
                                         ".git",
                                         "firebase-debug.log",
                                         "*.local"
                                     ],
                          "predeploy":  [
                                            "npm --prefix \"$RESOURCE_DIR\" run build"
                                        ],
                          "source":  "functions",
                          "codebase":  "default"
                      }
                  ]
}
