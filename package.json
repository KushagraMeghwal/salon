{
    "name": "salon",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:rules": "firebase emulators:exec --only firestore --project demo-chairly \"vitest run --config vitest.rules.config.ts\"",
        "emulators": "firebase emulators:start --project demo-chairly",
        "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore --project demo-chairly \"npm --prefix functions test\""
    },
    "private": true,
    "packageManager": "npm@11.12.1",
    "dependencies": {
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.0",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.0",
        "@angular/service-worker": "^21.2.23",
        "@ngx-translate/core": "^18.0.0",
        "@ngx-translate/http-loader": "^18.0.0",
        "@tailwindcss/forms": "^0.5.11",
        "firebase": "^12.19.0",
        "qrcode": "^1.5.4",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.10",
        "@angular/cli": "^21.2.10",
        "@angular/compiler-cli": "^21.2.0",
        "@firebase/rules-unit-testing": "^5.0.2",
        "@tailwindcss/postcss": "^4.1.12",
        "@types/qrcode": "^1.5.6",
        "firebase-tools": "^15.30.2",
        "jsdom": "^28.0.0",
        "postcss": "^8.5.3",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.1.12",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
